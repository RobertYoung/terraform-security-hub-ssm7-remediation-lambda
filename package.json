{
  "name": "terraform-securityhub-ssm7-remediation-lambda",
  "version": "1.0.0",
  "description": "Lambda function to remediate SSM.7 Security Hub findings by disabling public sharing",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "package": "npm run build && zip -r ../ssm7-remediation.zip dist/ node_modules/",
    "test": "jest",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.450.0",
    "@aws-sdk/client-sts": "^3.450.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.155",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.8.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.0"
  },
  "keywords": [
    "aws",
    "lambda",
    "security-hub",
    "ssm",
    "remediation"
  ],
  "author": "iamrobertyoung",
  "license": "MIT"
